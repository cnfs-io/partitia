# Copy this file to `.env` (gitignored) and fill in the secrets. Generate them:
#   openssl rand -base64 60 | tr -d '\n'   # AUTHENTIK_SECRET_KEY
#   openssl rand -base64 36 | tr -d '\n'   # PG_PASS
AUTHENTIK_SECRET_KEY=
PG_PASS=
PG_USER=authentik
PG_DB=authentik
AUTHENTIK_PORT=9000
# Initial admin (akadmin) bootstrap for first boot.
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
