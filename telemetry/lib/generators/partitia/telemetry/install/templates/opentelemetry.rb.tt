# frozen_string_literal: true

# OpenTelemetry SDK configuration — owned by this app, safe to edit.
#
# partitia-telemetry depends on the OTel *API* only; this file installs the
# *SDK*, which turns the partitia_* notification -> span bridge into exported
# spans. Settings come from Partitia::Telemetry::Config:
#
#   config/partitia_telemetry.yml -> credentials.partitia_telemetry -> PARTITIA_TELEMETRY_*
#
#   service_name   default: the app's module name, underscored
#   otlp_endpoint  default: http://localhost:4318 (pcm's stack/telemetry collector)
#   rack_tracing   default: true (request spans; PARTITIA_TELEMETRY_RACK_TRACING=false)
#
# The standard OTEL_* variables still win (OTel's convention): with
# OTEL_SERVICE_NAME set the SDK names the service, and with
# OTEL_EXPORTER_OTLP_(TRACES_)ENDPOINT or OTEL_TRACES_EXPORTER set it builds the
# exporter itself. OTEL_SDK_DISABLED=true turns the SDK off.

require "opentelemetry/sdk"
require "opentelemetry/exporter/otlp"

telemetry = Partitia::Telemetry::Config

OpenTelemetry::SDK.configure do |c|
  if (service_name = telemetry.sdk_service_name)
    c.service_name = service_name
  end

  if (endpoint = telemetry.sdk_traces_endpoint)
    c.add_span_processor(
      OpenTelemetry::SDK::Trace::Export::BatchSpanProcessor.new(
        OpenTelemetry::Exporter::OTLP::Exporter.new(endpoint: endpoint)
      )
    )
  end

<%= request_tracing_snippet -%>
end

# Attach the partitia-telemetry notification -> span bridge. The Railtie already
# calls this on boot; the explicit call here is harmless (idempotent) and makes
# the wiring visible next to the SDK config it depends on.
Partitia::Telemetry.install!
