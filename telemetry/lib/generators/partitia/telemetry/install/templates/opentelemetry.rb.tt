# frozen_string_literal: true

# OpenTelemetry SDK configuration — owned by this app, safe to edit.
#
# cnfs_telemetry itself depends on the OTel *API* only and stays a no-op until
# this file installs and configures the *SDK*. Everything below is host policy:
# the service name, which exporter, and where traces are sent. The gem's job is
# only to turn cnfs-prefixed ActiveSupport::Notifications into spans; this file
# decides what happens to those spans.
#
# Local target: an external telemetry stack (e.g. chorus/services/telemetry, run
# with `podman compose up`). The collector listens on localhost:4318 (OTLP/HTTP);
# Grafana is at http://localhost:8080.

require "opentelemetry/sdk"
require "opentelemetry/exporter/otlp"

# Host-side auto-instrumentation is opt-in. Uncomment after adding the matching
# gems to your Gemfile (see the cnfs_telemetry README). Use EITHER the -all
# metapackage OR hand-picked gems, never both.
# require "opentelemetry/instrumentation/all"

OpenTelemetry::SDK.configure do |c|
  c.service_name = ENV.fetch("OTEL_SERVICE_NAME", "<%= app_name %>")

  # The OTLP exporter defaults to http://localhost:4318 and honours the standard
  # OTEL_EXPORTER_OTLP_ENDPOINT env var, so a running telemetry stack works with
  # no extra config. Set that env var to point at a different collector.

  # Enable host framework auto-instrumentation (needs the gems required above):
  # c.use_all
  # or hand-pick:
  # c.use "OpenTelemetry::Instrumentation::Rails"
  # c.use "OpenTelemetry::Instrumentation::Rack"
end

# Attach the cnfs_telemetry notification -> span bridge. The Railtie already
# calls this on boot; the explicit call here is harmless (idempotent) and makes
# the wiring visible next to the SDK config it depends on.
CnfsTelemetry.install!
