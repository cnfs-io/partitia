<% content_for :title, "Account settings" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Account settings</h1>

  <div class="my-5 space-y-5">
    <div>
      <strong class="block font-medium mb-1">Name:</strong>
      <%= @account.name %>
    </div>
  </div>

  <%= link_to "Edit settings", edit_account_path, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
