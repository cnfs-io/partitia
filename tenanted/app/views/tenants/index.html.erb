<% content_for :title, "Tenants" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-md inline-block"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-3xl text-gray-900">Tenants</h1>
    <%= link_to "New tenant", new_tenant_path,
          class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium" %>
  </div>

  <% if @tenants.any? %>
    <div class="overflow-hidden rounded-lg border border-gray-200 divide-y divide-gray-200">
      <% @tenants.each do |tenant| %>
        <% host = "#{tenant.subdomain}.#{request.domain}#{request.port == 80 ? '' : ":#{request.port}"}" %>
        <div class="flex items-center justify-between gap-4 p-4 bg-white">
          <%= link_to tenant.name, "#{request.scheme}://#{host}",
                class: "font-semibold text-blue-600 hover:underline" %>
          <div class="flex gap-3 text-sm">
            <%= link_to "Show", tenant, class: "text-gray-600 hover:underline" %>
            <%= link_to "Edit", edit_tenant_path(tenant), class: "text-gray-600 hover:underline" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No tenants yet. Create one to get started.</p>
  <% end %>
</div>
