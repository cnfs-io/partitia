<div id="<%= dom_id tenant %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= tenant.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Subdomain:</strong>
    <%= tenant.subdomain %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Handle:</strong>
    <code><%= tenant.handle %></code>
  </div>
  <div>
    <strong class="block font-medium mb-1">Owner email:</strong>
    <%= tenant.owner_email %>
  </div>
</div>
