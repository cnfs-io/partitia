<%# Isolate all body rendering here: a later ActionText upgrade touches only this
    partial and the form. %>
<div id="<%= dom_id(message) %>" class="flex flex-col">
  <span class="text-xs font-semibold text-slate-500">
    <%= message.sender.chatter_display_name %>
  </span>
  <div class="inline-block px-3 py-2 rounded-lg bg-slate-100 self-start max-w-prose">
    <%= simple_format(message.content) %>
  </div>
</div>
