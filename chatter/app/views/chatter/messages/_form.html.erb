<%# A later ActionText upgrade swaps this text field for a rich-text editor. %>
<%= form_with model: [ conversation, message ],
      class: "flex gap-2",
      data: { controller: "chatter--reset", action: "turbo:submit-end->chatter--reset#reset" } do |f| %>
  <%= f.text_field :content,
        placeholder: "Type a message…",
        autocomplete: "off",
        class: "flex-1 border rounded px-3 py-2" %>
  <%= f.submit "Send", class: "px-4 py-2 rounded bg-indigo-600 text-white font-medium" %>
<% end %>
